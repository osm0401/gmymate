# orchestrator/.env — 실제 키를 담은 .env는 절대 커밋 금지
OPENAI_API_KEY=sk-...
GEMINI_API_KEY=...

# 선택 — 기본값이 있어 비워둬도 동작한다
# OPENAI_MODEL=gpt-5.5
# GEMINI_REVIEW_MODEL=gemini-2.5-pro
# GEMINI_AGY_MODEL=gemini-2.5-flash-lite
# BASE_BRANCH=main
# REPO_DIR=..
# CLAUDE_PERMISSION_MODE=acceptEdits
# MAX_ROUNDS=20            # 0 = 무제한 (계획서 원안). 기본 20은 폭주 방지용 상한
