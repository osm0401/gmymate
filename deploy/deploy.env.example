# Do not include ftp:// in the FTP host.
FTP_HOST=your_ftp_host
FTP_USER=your_ftp_user
# dothome's actual web root is "html", not "public_html" -- see
# https://docs.dothome.co.kr/books/faq-nCD/page/403
FTP_REMOTE_DIR=html

# Optional: used only to verify the uploaded site over HTTPS.
SITE_URL=https://your_public_site.example
